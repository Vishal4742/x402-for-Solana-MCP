GATEWAY_PORT=8080
GATEWAY_NETWORK=devnet
VERIFIER_PORT=8081
VERIFIER_BASE_URL=http://localhost:8081
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/x402?sslmode=disable
REDIS_URL=redis://localhost:6379
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SELLER_WALLET=ReplaceMeWithDevnetSellerWallet
PAYMENT_CHALLENGE_TTL_SECONDS=300
VERIFY_LOCK_TTL_SECONDS=30
# mock: trust the observed fields (local demos). rpc: inspect the real transaction on chain.
SOLANA_VERIFY_MODE=mock
# The network the verifier is bound to; a challenge for any other network is rejected in rpc mode.
VERIFIER_NETWORK=devnet
# Where the gateway forwards settled tool calls. Empty keeps the built-in stub response.
UPSTREAM_MCP_URL=http://localhost:9090
# Browser origin allowed to call the API (the operator dashboard). "*" is fine for local dev.
DASHBOARD_ORIGIN=*
# Shared secret the gateway sends as X-Gateway-Key; the example server checks it when set.
GATEWAY_KEY=x402_sk_dev_local
EXAMPLE_SERVER_PORT=9090
DEFAULT_SERVER_ID=srv_01HX3K
DEFAULT_SERVER_NAME=agent-tools-prod
DEFAULT_TOOL_PRICE_ATOMIC=0
TOOL_PRICING_JSON={"ping":{"priceAtomic":0,"description":"Healthcheck endpoint.","enabled":true},"premium.search":{"priceAtomic":1000000,"description":"Paid MCP search tool.","enabled":true},"premium.codegen":{"priceAtomic":2500000,"description":"Paid code generation tool.","enabled":true}}
